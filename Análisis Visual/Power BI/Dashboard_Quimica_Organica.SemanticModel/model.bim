        "partitions": [
          {
            "name": "Compuestos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Excel.Workbook(File.Contents(RutaDatos), null, true),",
                "    Datos = Origen{[Item=\"Compuestos\",Kind=\"Table\"]}[Data],",
                "    TiposCambiados = Table.TransformColumnTypes(Datos, {{\"Compuesto\", type text}, {\"CAS\", type text}, {\"Familia\", type text}, {\"Grupo_funcional\", type text}, {\"Puentes_H\", type text}, {\"Asignado\", type text}, {\"Estado_25C\", type text}, {\"Rango_PM\", type text}, {\"Rango_PM_Orden\", Int64.Type}, {\"PM_g_mol\", type number}, {\"pf_C\", type number}, {\"Peb_C\", type number}, {\"Densidad_g_cm3\", type number}, {\"Solubilidad_g_L\", type number}, {\"Solubilidad_texto\", type text}, {\"pKa\", type number}, {\"Momento_dipolar_D\", type number}}),",
                "    FilasValidas = Table.SelectRows(TiposCambiados, each [Compuesto] <> null and [Compuesto] <> \"\"),",
                "    ColumnasRenombradas = Table.RenameColumns(FilasValidas, {{\"Grupo_funcional\", \"Grupo funcional\"}, {\"Puentes_H\", \"Puentes de H\"}, {\"Estado_25C\", \"Estado a 25 °C\"}, {\"Rango_PM\", \"Rango PM\"}, {\"Rango_PM_Orden\", \"Rango PM Orden\"}, {\"PM_g_mol\", \"PM (g/mol)\"}, {\"pf_C\", \"pf (°C)\"}, {\"Peb_C\", \"Peb (°C)\"}, {\"Densidad_g_cm3\", \"Densidad (g/cm3)\"}, {\"Solubilidad_g_L\", \"Solubilidad (g/L)\"}, {\"Solubilidad_texto\", \"Solubilidad (texto)\"}, {\"Momento_dipolar_D\", \"Momento dipolar (D)\"}})",
                "in",
                "    ColumnasRenombradas"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total compuestos",
            "expression": [
              "DISTINCTCOUNT ( Compuestos[Compuesto] )"
            ],
            "formatString": "0",
            "description": "Número de compuestos distintos en el filtro actual.",
            "lineageTag": "a5e3e439-a382-4bba-a5bc-7791722c4e1f"
          },
          {
            "name": "PM promedio (g/mol)",
            "expression": [
              "AVERAGE ( Compuestos[PM (g/mol)] )"
            ],
            "formatString": "0.00",
            "description": "Peso molecular promedio.",
            "lineageTag": "fb2d57d6-0793-4248-b984-3906f66c5fd1"
          },
          {
            "name": "Peb promedio (°C)",
            "expression": [
              "AVERAGE ( Compuestos[Peb (°C)] )"
            ],
            "formatString": "0.0",
            "description": "Punto de ebullición promedio.",
            "lineageTag": "cd29aea4-dc5c-4ce0-abc2-4be1fa78dbcf"
          },
          {
            "name": "pf promedio (°C)",
            "expression": [
              "AVERAGE ( Compuestos[pf (°C)] )"
            ],
            "formatString": "0.0",
            "description": "Punto de fusión promedio.",
            "lineageTag": "dfed6605-2b9b-4754-845c-33c84094e195"
          },
          {
            "name": "Densidad promedio (g/cm3)",
            "expression": [
              "AVERAGE ( Compuestos[Densidad (g/cm3)] )"
            ],
            "formatString": "0.000",
            "description": "Densidad promedio.",
            "lineageTag": "f1853c8f-224b-4325-8243-732041d18904"
          },
          {
            "name": "Solubilidad promedio (g/L)",
            "expression": [
              "AVERAGE ( Compuestos[Solubilidad (g/L)] )"
            ],
            "formatString": "0.0",
            "description": "Solubilidad en agua promedio.",
            "lineageTag": "440c6623-1b37-464c-89aa-2c91bd4d0e01"
          },
          {
            "name": "pKa promedio",
            "expression": [
              "AVERAGE ( Compuestos[pKa] )"
            ],
            "formatString": "0.00",
            "description": "pKa promedio.",
            "lineageTag": "3da77990-3c28-48e7-b950-7853c0df318e"
          },
          {
            "name": "Momento dipolar promedio (D)",
            "expression": [
              "AVERAGE ( Compuestos[Momento dipolar (D)] )"
            ],
            "formatString": "0.00",
            "description": "Momento dipolar promedio en Debye.",
            "lineageTag": "1525da69-afb8-4b5c-90be-0c42f88f89bb"
          },
          {
            "name": "Rango Peb (°C)",
            "expression": [
              "MAX ( Compuestos[Peb (°C)] ) - MIN ( Compuestos[Peb (°C)] )"
            ],
            "formatString": "0.0",
            "description": "Diferencia entre el mayor y el menor punto de ebullición.",
            "lineageTag": "1f70d230-54ed-4d64-a1ec-46801c5a8322"
          },
          {
            "name": "r PM vs Peb",
            "expression": [
              "VAR T =",
              "    FILTER (",
              "        ADDCOLUMNS (",
              "            VALUES ( Compuestos[Compuesto] ),",
              "            \"@x\", CALCULATE ( AVERAGE ( Compuestos[PM (g/mol)] ) ),",
              "            \"@y\", CALCULATE ( AVERAGE ( Compuestos[Peb (°C)] ) )",
              "        ),",
              "        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )",
              "    )",
              "VAR n = COUNTROWS ( T )",
              "VAR mx = AVERAGEX ( T, [@x] )",
              "VAR my = AVERAGEX ( T, [@y] )",
              "VAR cov = SUMX ( T, ( [@x] - mx ) * ( [@y] - my ) )",
              "VAR sx = SQRT ( SUMX ( T, ( [@x] - mx ) ^ 2 ) )",
              "VAR sy = SQRT ( SUMX ( T, ( [@y] - my ) ^ 2 ) )",
              "RETURN",
              "    IF ( n >= 3, DIVIDE ( cov, sx * sy ) )"
            ],
            "formatString": "0.00",
            "description": "Coeficiente de correlación de Pearson entre PM (g/mol) y Peb (°C) (mínimo 3 compuestos con ambos datos).",
            "lineageTag": "d12b00b3-9378-4fc4-8f3a-f03d76371ede"
          },
          {
            "name": "r PM vs pf",
            "expression": [
              "VAR T =",
              "    FILTER (",
              "        ADDCOLUMNS (",
              "            VALUES ( Compuestos[Compuesto] ),",
              "            \"@x\", CALCULATE ( AVERAGE ( Compuestos[PM (g/mol)] ) ),",
              "            \"@y\", CALCULATE ( AVERAGE ( Compuestos[pf (°C)] ) )",
              "        ),",
              "        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )",
              "    )",
              "VAR n = COUNTROWS ( T )",
              "VAR mx = AVERAGEX ( T, [@x] )",
              "VAR my = AVERAGEX ( T, [@y] )",
              "VAR cov = SUMX ( T, ( [@x] - mx ) * ( [@y] - my ) )",
              "VAR sx = SQRT ( SUMX ( T, ( [@x] - mx ) ^ 2 ) )",
              "VAR sy = SQRT ( SUMX ( T, ( [@y] - my ) ^ 2 ) )",
              "RETURN",
              "    IF ( n >= 3, DIVIDE ( cov, sx * sy ) )"
            ],
            "formatString": "0.00",
            "description": "Coeficiente de correlación de Pearson entre PM (g/mol) y pf (°C) (mínimo 3 compuestos con ambos datos).",
            "lineageTag": "ea53a1c6-e386-4927-aa90-3e499c9e42cd"
          },
          {
            "name": "r Momento dipolar vs Peb",
            "expression": [
              "VAR T =",
              "    FILTER (",
              "        ADDCOLUMNS (",
              "            VALUES ( Compuestos[Compuesto] ),",
              "            \"@x\", CALCULATE ( AVERAGE ( Compuestos[Momento dipolar (D)] ) ),",
              "            \"@y\", CALCULATE ( AVERAGE ( Compuestos[Peb (°C)] ) )",
              "        ),",
              "        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )",
              "    )",
              "VAR n = COUNTROWS ( T )",
              "VAR mx = AVERAGEX ( T, [@x] )",
              "VAR my = AVERAGEX ( T, [@y] )",
              "VAR cov = SUMX ( T, ( [@x] - mx ) * ( [@y] - my ) )",
              "VAR sx = SQRT ( SUMX ( T, ( [@x] - mx ) ^ 2 ) )",
              "VAR sy = SQRT ( SUMX ( T, ( [@y] - my ) ^ 2 ) )",
              "RETURN",
              "    IF ( n >= 3, DIVIDE ( cov, sx * sy ) )"
            ],
            "formatString": "0.00",
            "description": "Coeficiente de correlación de Pearson entre Momento dipolar (D) y Peb (°C) (mínimo 3 compuestos con ambos datos).",
            "lineageTag": "d0268bcf-b998-47fc-97ba-96a2677a011a"
          },
          {
            "name": "r Densidad vs Solubilidad",
            "expression": [
              "VAR T =",
              "    FILTER (",
              "        ADDCOLUMNS (",
              "            VALUES ( Compuestos[Compuesto] ),",
              "            \"@x\", CALCULATE ( AVERAGE ( Compuestos[Densidad (g/cm3)] ) ),",
              "            \"@y\", CALCULATE ( AVERAGE ( Compuestos[Solubilidad (g/L)] ) )",
              "        ),",
              "        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )",
              "    )",
              "VAR n = COUNTROWS ( T )",
              "VAR mx = AVERAGEX ( T, [@x] )",
              "VAR my = AVERAGEX ( T, [@y] )",
              "VAR cov = SUMX ( T, ( [@x] - mx ) * ( [@y] - my ) )",
              "VAR sx = SQRT ( SUMX ( T, ( [@x] - mx ) ^ 2 ) )",
              "VAR sy = SQRT ( SUMX ( T, ( [@y] - my ) ^ 2 ) )",
              "RETURN",
              "    IF ( n >= 3, DIVIDE ( cov, sx * sy ) )"
            ],
            "formatString": "0.00",
            "description": "Coeficiente de correlación de Pearson entre Densidad (g/cm3) y Solubilidad (g/L) (mínimo 3 compuestos con ambos datos).",
            "lineageTag": "6e7db11a-0550-44fc-8c12-3c49e30b44f2"
          }
        ]
      },
