        "partitions": [
          {
            "name": "Reacciones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Excel.Workbook(File.Contents(RutaDatos), null, true),",
                "    Datos = Origen{[Item=\"Reacciones\",Kind=\"Table\"]}[Data],",
                "    TiposCambiados = Table.TransformColumnTypes(Datos, {{\"ID_Reaccion\", Int64.Type}, {\"CAS_reaccion\", type text}, {\"Nombre_reaccion\", type text}, {\"Tipo_reaccion\", type text}, {\"Compuesto\", type text}, {\"Reactivo_2\", type text}, {\"Producto\", type text}, {\"PM_producto\", type number}, {\"Peb_producto_C\", type number}, {\"Catalizador\", type text}, {\"Solvente\", type text}, {\"Medio\", type text}, {\"Condiciones\", type text}, {\"Tiempo_h\", type number}, {\"Temperatura_C\", type number}, {\"Usa_catalizador\", type text}}),",
                "    FilasValidas = Table.SelectRows(TiposCambiados, each [ID_Reaccion] <> null and [ID_Reaccion] <> \"\"),",
                "    ColumnasRenombradas = Table.RenameColumns(FilasValidas, {{\"ID_Reaccion\", \"ID Reacción\"}, {\"CAS_reaccion\", \"CAS reacción\"}, {\"Nombre_reaccion\", \"Nombre reacción\"}, {\"Tipo_reaccion\", \"Código tipo\"}, {\"Reactivo_2\", \"Reactivo 2\"}, {\"PM_producto\", \"PM producto (g/mol)\"}, {\"Peb_producto_C\", \"Peb producto (°C)\"}, {\"Tiempo_h\", \"Tiempo (h)\"}, {\"Temperatura_C\", \"Temperatura (°C)\"}, {\"Usa_catalizador\", \"Usa catalizador\"}})",
                "in",
                "    ColumnasRenombradas"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total reacciones",
            "expression": [
              "COUNTROWS ( Reacciones )"
            ],
            "formatString": "0",
            "description": "Número de reacciones en el filtro actual.",
            "lineageTag": "b0c0072a-554f-46e7-96d3-7374d403577a"
          },
          {
            "name": "% con catalizador",
            "expression": [
              "DIVIDE ( CALCULATE ( COUNTROWS ( Reacciones ), Reacciones[Usa catalizador] = \"Sí\" ), COUNTROWS ( Reacciones ) )"
            ],
            "formatString": "0.0%",
            "description": "Porcentaje de reacciones que usan catalizador.",
            "lineageTag": "48680540-7d27-4e9f-8874-722c0c96f998"
          },
          {
            "name": "Tiempo medio (h)",
            "expression": [
              "AVERAGE ( Reacciones[Tiempo (h)] )"
            ],
            "formatString": "0.0",
            "description": "Tiempo de reacción promedio en horas.",
            "lineageTag": "2c57160c-c228-4011-9951-e37b2daee523"
          },
          {
            "name": "Temperatura media (°C)",
            "expression": [
              "AVERAGE ( Reacciones[Temperatura (°C)] )"
            ],
            "formatString": "0.0",
            "description": "Temperatura de reacción promedio (TA = 25 °C).",
            "lineageTag": "d73f5f9d-de88-43e6-bf8d-64bd896eb801"
          },
          {
            "name": "Δ PM producto - reactivo",
            "expression": [
              "AVERAGEX (",
              "    FILTER (",
              "        Reacciones,",
              "        NOT ISBLANK ( Reacciones[PM producto (g/mol)] )",
              "            && NOT ISBLANK ( RELATED ( Compuestos[PM (g/mol)] ) )",
              "    ),",
              "    Reacciones[PM producto (g/mol)] - RELATED ( Compuestos[PM (g/mol)] )",
              ")"
            ],
            "formatString": "0.0",
            "description": "Aumento promedio de peso molecular del producto respecto al reactivo principal.",
