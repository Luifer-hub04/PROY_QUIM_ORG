                      "fontSize": "10.5pt",
                      "color": "#2C3E50",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "R₃N + CH₃I → R₃NCH₃⁺ I⁻; ya no es básica.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2C3E50"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Acilación: ",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2C3E50",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "RNH₂ + R'COCl → R'CONHR + HCl; forma amidas.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2C3E50"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Ácido nitroso: ",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2C3E50",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "1.ª → sal de diazonio; 2.ª → N-nitrosamina; 3.ª → sal soluble.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2C3E50"
                    }
                  }
