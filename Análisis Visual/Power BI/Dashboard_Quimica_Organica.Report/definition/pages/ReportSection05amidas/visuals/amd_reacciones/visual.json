                      "fontSize": "10.5pt",
                      "color": "#2C3E50",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "RCONH₂ + OH⁻ (Δ) → RCOO⁻ + NH₃.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2C3E50"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Síntesis: ",
