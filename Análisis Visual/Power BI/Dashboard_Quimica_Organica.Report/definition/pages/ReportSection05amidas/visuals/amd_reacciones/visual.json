                      "color": "#2C3E50",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "RCOOH + R'NH₂ → sal de amonio → (Δ, −H₂O) RCONHR'.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2C3E50"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "En el ambiente: ",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2C3E50",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "la ureasa hidroliza la urea a NH₃ + CO₂ en suelos fertilizados.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2C3E50"
