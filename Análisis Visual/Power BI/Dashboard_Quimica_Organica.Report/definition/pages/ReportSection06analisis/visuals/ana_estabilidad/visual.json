                      "fontSize": "10pt",
                      "color": "#2C3E50"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "La base de CAS-SciFinder no reporta rendimientos ni conversiones; por eso la reactividad se mide con las condiciones de cada reacción.",
